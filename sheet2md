#!/usr/bin/env python3
# artefact-version: sheet2md/1.0
"""sheet2md — render spreadsheet data (.xlsx or .csv) as Markdown table(s).

Turns "what a spreadsheet shows" into clean GitHub-flavoured Markdown. Reads
.xlsx workbooks natively (stdlib zipfile+XML, no openpyxl) so it can export
several sheets as separate tables, each titled with its sheet name; also reads
a single .csv. Pure stdlib — no dependencies.

SHEETS (xlsx)
  --sheet SPEC      which sheets: comma list of names or 1-based indices, or "all".
                    Default: all sheets. Each becomes its own table titled with the
                    sheet name (## Name). Use --title-level / --no-title to change.
  --title-level N   heading level for the sheet title (default 2 -> "## Name").
  --no-title        do not emit sheet-name titles.
  --title TEXT      explicit title (single-table / csv input).

SELECTION (applied to each exported sheet)
  --header N        1-based row to use as the header (default: first populated row).
  --cols SPEC       columns to include (default: all populated columns).
                    SPEC = comma list of 1-based indices, ranges "2-11", or header
                    names (case-insensitive, prefix ok). Output order is honoured.
  --rows SPEC       data records to include (default: all populated rows after header).
                    SPEC = ranges/indices in 1-based data-row numbering, e.g. "1-24,27".

FORMATTING
  --align SPEC      l|r|c for all, a positional list "l,l,r,r", or pairs "3:r,Result:c".
                    Default: numeric-looking columns right, others left.
  --round SPEC      decimals for numeric cells: one int for all, positional list, or
                    name/idx:places pairs, e.g. "Measured:2,7:3".
  --delimiter CH    csv delimiter (default: sniff , ; tab).
  --decimal SEP     decimal separator of INPUT numbers: . (default) | , | auto.
                    Use ',' for DE/EU exports where "2,999" means 2.999 (otherwise
                    it is misread as 2999). xlsx-native numbers are locale-free and
                    unaffected; this matters for CSV input and text-typed cells.
  --out-decimal SEP separator to WRITE rounded numbers with: . (default) | , .

  ⚠ EU/national CSVs: when the decimal separator is a comma, export the CSV
  SEMICOLON-delimited (LibreOffice/Excel do this in a DE locale) or with numbers
  QUOTED as text, so the decimal comma is not mistaken for a field delimiter —
  then pass --decimal ,
  --keep-empty      do NOT drop fully-empty columns / rows.
  --no-trim         do NOT strip surrounding whitespace in cells.

OUTPUT
  -o FILE           write to FILE (default: stdout).

EXAMPLES
  sheet2md book.xlsx                                  # every sheet, tidied & titled
  sheet2md book.xlsx --sheet "Measurements" --header 39 --cols 2-11 --round "Measured:2"
  sheet2md export.csv --cols "Point ID,From,Measured" --align "l,l,r" --round 2
"""
import sys as _s; _s.argv[1:2]==["--version"] and (print("sheet2md/1.0"), _s.exit(0))
import argparse
import csv
import re
import sys
import xml.etree.ElementTree as ET
import zipfile


def _ln(tag):
    return tag.split("}", 1)[-1]


def _col_index(ref):
    m = re.match(r"[A-Za-z]+", ref or "")
    if not m:
        return 0
    n = 0
    for ch in m.group(0).upper():
        n = n * 26 + (ord(ch) - 64)
    return n - 1


def read_xlsx(path):
    """Return list of (sheet_name, rows) where rows is list[list[str]]."""
    z = zipfile.ZipFile(path)
    names = z.namelist()
    shared = []
    if "xl/sharedStrings.xml" in names:
        root = ET.fromstring(z.read("xl/sharedStrings.xml"))
        for si in root:
            shared.append("".join(t.text or "" for t in si.iter() if _ln(t.tag) == "t"))
    wb = ET.fromstring(z.read("xl/workbook.xml"))
    sheet_defs = []
    for s in wb.iter():
        if _ln(s.tag) == "sheet":
            rid = next((v for k, v in s.attrib.items() if _ln(k) == "id"), None)
            sheet_defs.append((s.attrib.get("name", "Sheet"), rid))
    rels = {}
    if "xl/_rels/workbook.xml.rels" in names:
        for rel in ET.fromstring(z.read("xl/_rels/workbook.xml.rels")):
            rels[rel.attrib["Id"]] = rel.attrib["Target"]
    out = []
    for name, rid in sheet_defs:
        target = rels.get(rid, "")
        if not target:
            continue
        full = target.lstrip("/")
        if not full.startswith("xl/"):
            full = "xl/" + full
        if full not in names:
            continue
        ws = ET.fromstring(z.read(full))
        rows = []
        for row in ws.iter():
            if _ln(row.tag) != "row":
                continue
            cells, maxc = {}, -1
            for c in row:
                if _ln(c.tag) != "c":
                    continue
                col = _col_index(c.attrib.get("r", ""))
                t = c.attrib.get("t")
                vtext = istext = None
                for ch in c:
                    ln = _ln(ch.tag)
                    if ln == "v":
                        vtext = ch.text
                    elif ln == "is":
                        istext = "".join(tt.text or "" for tt in ch.iter() if _ln(tt.tag) == "t")
                if t == "s" and vtext is not None:
                    val = shared[int(vtext)] if int(vtext) < len(shared) else ""
                elif t == "inlineStr":
                    val = istext or ""
                else:
                    val = vtext if vtext is not None else ""
                cells[col] = val
                maxc = max(maxc, col)
            rows.append([cells.get(i, "") for i in range(maxc + 1)])
        out.append((name, rows))
    return out


def sniff_delim(sample, decimal="."):
    """Pick the delimiter by column-count CONSISTENCY across lines.

    When decimal="," the comma is the decimal separator, so it is excluded as a
    delimiter candidate (DE/EU CSVs are ';'- or tab-delimited)."""
    lines = [ln for ln in sample.splitlines()[:50] if ln.strip()]
    cands = [";", "\t"] if decimal == "," else [",", ";", "\t"]
    best, best_score = None, (-1, -1)
    for d in cands:
        nonzero = [ln.count(d) for ln in lines if ln.count(d) > 0]
        if not nonzero:
            continue
        modal = max(set(nonzero), key=nonzero.count)   # most common column count
        score = (nonzero.count(modal), modal)          # consistency, then width
        if score > best_score:
            best_score, best = score, d
    return best or (";" if decimal == "," else ",")


def read_csv(path, delim, decimal="."):
    raw = open(path, encoding="utf-8-sig").read() if path else sys.stdin.read()
    d = delim or sniff_delim(raw, decimal)
    if d == "\\t":
        d = "\t"
    return list(csv.reader(raw.splitlines(), delimiter=d))


def parse_int_ranges(spec, lo, hi):
    out = []
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-", 1)
            out.extend(range(int(a), int(b) + 1))
        else:
            out.append(int(part))
    return [i for i in out if lo <= i <= hi]


def resolve_cols(spec, header, ncols):
    if spec is None:
        return None
    lower = [h.strip().lower() for h in header]
    idxs = []
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part and all(p.strip().isdigit() for p in part.split("-", 1)):
            a, b = part.split("-", 1)
            idxs.extend(range(int(a) - 1, int(b)))
        elif part.isdigit():
            idxs.append(int(part) - 1)
        else:
            key = part.lower()
            m = next((i for i, h in enumerate(lower) if h == key), None)
            if m is None:
                m = next((i for i, h in enumerate(lower) if h.startswith(key)), None)
            if m is None:
                sys.exit(f"sheet2md: column '{part}' not found in header")
            idxs.append(m)
    return [i for i in idxs if 0 <= i < ncols]


def to_float(s, dec="."):
    """Parse a cell to float, honouring the decimal convention.

    dec="."   comma treated as thousands separator (US/UK): "1,234.5" -> 1234.5
    dec=","   comma is the decimal (DE/EU): "1.234,5" -> 1234.5, "2,999" -> 2.999
    dec="auto" if both separators present the rightmost is the decimal; if only
              a comma is present it is treated as the decimal (EU assumption).
    """
    if s is None:
        return None
    t = s.strip().replace(" ", "").replace(" ", "")
    if not t:
        return None
    if dec == "auto":
        if "," in t and "." in t:
            dec = "," if t.rfind(",") > t.rfind(".") else "."
        elif "," in t:
            dec = ","
        else:
            dec = "."
    if dec == ",":
        t = t.replace(".", "").replace(",", ".")
    else:
        t = t.replace(",", "")
    try:
        return float(t)
    except ValueError:
        return None


def is_number(s, dec="."):
    return to_float(s, dec) is not None


def parse_percol(spec, out_headers):
    if spec is None:
        return {}
    n = len(out_headers)
    lower = [h.strip().lower() for h in out_headers]
    if ":" not in spec and "," not in spec:
        return {i: spec.strip() for i in range(n)}
    result = {}
    if ":" in spec:
        for part in spec.split(","):
            if not part.strip():
                continue
            key, val = part.split(":", 1)
            key, val = key.strip(), val.strip()
            if key.isdigit():
                pos = int(key) - 1
                if 0 <= pos < n:
                    result[pos] = val
            else:
                k = key.lower()
                pos = next((i for i, h in enumerate(lower) if h == k), None)
                if pos is None:
                    pos = next((i for i, h in enumerate(lower) if h.startswith(k)), None)
                if pos is not None:
                    result[pos] = val
    else:
        for i, val in enumerate(p.strip() for p in spec.split(",")):
            if i < n and val:
                result[i] = val
    return result


def norm_align(v):
    v = v.lower()
    return {"l": "left", "left": "left", "r": "right", "right": "right",
            "c": "center", "center": "center", "centre": "center"}.get(v, "left")


def esc(cell, trim):
    if trim:
        cell = cell.strip()
    return cell.replace("\r\n", " ").replace("\n", "<br>").replace("|", "\\|")


def render(rows, args):
    if not rows:
        return ""
    trim = not args.no_trim
    hidx = (args.header - 1) if args.header else next(
        (i for i, r in enumerate(rows) if any(c.strip() for c in r)), 0)
    ncols = max((len(r) for r in rows), default=0)
    header = (rows[hidx] + [""] * ncols)[:ncols]
    data = [(r + [""] * ncols)[:ncols] for r in rows[hidx + 1:]]

    sel = resolve_cols(args.cols, header, ncols)
    if sel is None:
        sel = (list(range(ncols)) if args.keep_empty else
               [c for c in range(ncols)
                if header[c].strip() or any(row[c].strip() for row in data)])
    if not sel:
        return ""
    out_headers = [header[c] for c in sel]

    if args.rows:
        wanted = set(parse_int_ranges(args.rows, 1, len(data)))
        data = [row for i, row in enumerate(data, 1) if i in wanted]
    elif not args.keep_empty:
        data = [row for row in data if any(row[c].strip() for c in sel)]

    dec = args.decimal
    out_dec = args.out_decimal
    round_map = parse_percol(args.round, out_headers)
    align_spec = parse_percol(args.align, out_headers)
    aligns = []
    for pos, c in enumerate(sel):
        if pos in align_spec:
            aligns.append(norm_align(align_spec[pos]))
        else:
            vals = [row[c].strip() for row in data if row[c].strip()]
            aligns.append("right" if vals and all(is_number(v, dec) for v in vals) else "left")

    def fmt(cell, pos):
        cell = cell.strip() if trim else cell
        if pos in round_map:
            f = to_float(cell, dec)
            if f is not None:
                cell = f"{f:.{int(round_map[pos])}f}"
                if out_dec == ",":
                    cell = cell.replace(".", ",")
        return cell

    sep = {"left": ":---", "right": "---:", "center": ":--:"}
    lines = ["| " + " | ".join(esc(h, trim) for h in out_headers) + " |",
             "| " + " | ".join(sep[a] for a in aligns) + " |"]
    for row in data:
        lines.append("| " + " | ".join(esc(fmt(row[c], pos), trim)
                                       for pos, c in enumerate(sel)) + " |")
    return "\n".join(lines) + "\n"


def select_sheets(sheets, spec):
    if not spec or spec.lower() == "all":
        return sheets
    names = {n.lower(): (n, r) for n, r in sheets}
    picked = []
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if part.isdigit():
            i = int(part) - 1
            if 0 <= i < len(sheets):
                picked.append(sheets[i])
        elif part.lower() in names:
            picked.append(names[part.lower()])
        else:
            sys.exit(f"sheet2md: sheet '{part}' not found")
    return picked


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("file", nargs="?")
    ap.add_argument("--sheet")
    ap.add_argument("--title-level", type=int, default=2)
    ap.add_argument("--no-title", action="store_true")
    ap.add_argument("--title")
    ap.add_argument("--header", type=int)
    ap.add_argument("--cols")
    ap.add_argument("--rows")
    ap.add_argument("--align")
    ap.add_argument("--round")
    ap.add_argument("--delimiter")
    ap.add_argument("--decimal", choices=[".", ",", "auto"], default=".",
                    help="decimal separator of the INPUT numbers (default '.'; use ',' for DE/EU data)")
    ap.add_argument("--out-decimal", choices=[".", ","], default=".",
                    help="decimal separator to WRITE rounded numbers with (default '.')")
    ap.add_argument("--keep-empty", action="store_true")
    ap.add_argument("--no-trim", action="store_true")
    ap.add_argument("-o", "--output")
    ap.add_argument("-h", "--help", action="store_true")
    args = ap.parse_args()
    if args.help:
        print(__doc__)
        return

    is_xlsx = args.file and args.file.lower().endswith(".xlsx")
    blocks = []
    if is_xlsx:
        sheets = select_sheets(read_xlsx(args.file), args.sheet)
        multi = len(sheets) > 1
        for name, rows in sheets:
            body = render(rows, args)
            if not body:
                continue
            if args.title:
                title = args.title
            elif args.no_title or (not multi and args.sheet):
                title = None
            else:
                title = name if (multi or not args.no_title) else None
            if args.no_title:
                title = None
            if title:
                blocks.append("#" * max(1, args.title_level) + " " + title + "\n\n" + body)
            else:
                blocks.append(body)
    else:
        rows = read_csv(args.file, args.delimiter)
        body = render(rows, args)
        if args.title and not args.no_title:
            body = "#" * max(1, args.title_level) + " " + args.title + "\n\n" + body
        blocks.append(body)

    text = "\n".join(blocks)
    if args.output:
        open(args.output, "w", encoding="utf-8").write(text)
    else:
        sys.stdout.write(text)


if __name__ == "__main__":
    main()
